# ==============================================================================
# Environment Configuration Template (.env.example)
#
# Quickstart:
#   1. Copy this file to .env:
#        cp .env.example .env
#   2. Choose your model configuration preset (e.g. gpt-oss-120b or gemma-4)
#   3. Fill in your GCP PROJECT_ID and any custom variables
#   4. Run ./deploy.sh
# ==============================================================================

# --- Required / Primary Configuration ---
PROJECT_ID=your-gcp-project-id
# HF_TOKEN=hf_your_huggingface_access_token_if_needed
# SERVICE_ACCOUNT=geap-endpoint-runner@your-gcp-project-id.iam.gserviceaccount.com

# --- Model Preset Selection ---
# Automatically loads preset from configurations/<CONFIG>.env (e.g. gpt-oss-120b, gemma-4, generic)
CONFIG=gpt-oss-120b

# --- Public / Infrastructure Variables (Optional Overrides) ---
REGION=us-central1
ARTIFACT_REGISTRY_REPOSITORY_NAME=geap-models
# IMAGE_NAME=gpt-oss-120b
# TAG=latest
# MODEL_NAME=gpt-oss-120b-geap
# ENDPOINT_NAME=gpt-oss-120b-endpoint

# --- Model & Serving Engine Settings (Override if not using presets) ---
# MODEL_ID=openai/gpt-oss-120b
# TENSOR_PARALLEL_SIZE=1
# MAX_MODEL_LEN=32768
# GPU_MEMORY_UTILIZATION=0.92
# MAX_NUM_SEQS=128
# MAX_NUM_BATCHED_TOKENS=4096
# REASONING_PARSER=openai_gptoss
# TOOL_CALL_PARSER=openai
# ENFORCE_EAGER=true
# SHARED_MEMORY_MB=16384

# --- Hardware Configurations ---
# Options:
#   - 1x H100 80GB:  MACHINE_TYPE=a3-highgpu-1g, ACCELERATOR_TYPE=nvidia-h100-80gb
#   - 1x RTX PRO 6000 96GB (G4): MACHINE_TYPE=g4-standard-48, ACCELERATOR_TYPE=nvidia-rtx-pro-6000
#   - 1x A100 80GB:  MACHINE_TYPE=a2-ultragpu-1g, ACCELERATOR_TYPE=nvidia-a100-80gb
#   - 8x L4 24GB:    MACHINE_TYPE=g2-standard-96, ACCELERATOR_TYPE=nvidia-l4, ACCELERATOR_COUNT=8, TENSOR_PARALLEL_SIZE=8
MACHINE_TYPE=a3-highgpu-1g
ACCELERATOR_TYPE=nvidia-h100-80gb
ACCELERATOR_COUNT=1
MIN_REPLICA_COUNT=1
MAX_REPLICA_COUNT=1

# --- Build Configurations ---
BUILD_METHOD=cloudbuild
SKIP_BUILD=false
ENABLE_APIS=true
