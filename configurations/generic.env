# ==============================================================================
# Generic Hugging Face Model Configuration Preset
# Use this as a starting point to deploy any Hugging Face model to Agent Platform
# ==============================================================================

# Model Identification (Specify any Hugging Face model ID)
MODEL_ID=meta-llama/Llama-3.3-70B-Instruct
IMAGE_NAME=custom-llm
MODEL_NAME=custom-llm-geap
ENDPOINT_NAME=custom-llm-endpoint

# vLLM Engine Settings
TENSOR_PARALLEL_SIZE=1
MAX_MODEL_LEN=16384
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=128
MAX_NUM_BATCHED_TOKENS=4096
REASONING_PARSER=
TOOL_CALL_PARSER=auto
ENFORCE_EAGER=false
DTYPE=auto
SHARED_MEMORY_MB=16384

# Hardware & Accelerator Configurations
MACHINE_TYPE=a3-highgpu-1g
ACCELERATOR_TYPE=nvidia-h100-80gb
ACCELERATOR_COUNT=1
MIN_REPLICA_COUNT=1
MAX_REPLICA_COUNT=1
