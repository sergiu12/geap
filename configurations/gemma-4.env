# ==============================================================================
# Model Preset: Google Gemma 4 / Gemma Family (e.g. google/gemma-4-27b-it)
# ==============================================================================

# Model Identification
MODEL_ID=google/gemma-4-27b-it
IMAGE_NAME=gemma-4-27b
MODEL_NAME=gemma-4-27b-geap
ENDPOINT_NAME=gemma-4-27b-endpoint

# vLLM Engine Settings
TENSOR_PARALLEL_SIZE=1
MAX_MODEL_LEN=16384
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=128
MAX_NUM_BATCHED_TOKENS=4096
REASONING_PARSER=
TOOL_CALL_PARSER=hermes
ENFORCE_EAGER=false
DTYPE=bfloat16
SHARED_MEMORY_MB=16384

# Hardware & Accelerator Configurations
# Options:
#   - 1x NVIDIA H100 80GB (a3-highgpu-1g) [Recommended for 27B]
#   - 1x NVIDIA RTX PRO 6000 96GB (g4-standard-48) [Recommended for 27B]
#   - 1x NVIDIA A100 80GB (a2-ultragpu-1g)
#   - 2x NVIDIA L4 24GB (g2-standard-48, TENSOR_PARALLEL_SIZE=2)
#   - 1x NVIDIA L4 24GB (g2-standard-24, for 9B model variants)
MACHINE_TYPE=a3-highgpu-1g
ACCELERATOR_TYPE=nvidia-h100-80gb
ACCELERATOR_COUNT=1
MIN_REPLICA_COUNT=1
MAX_REPLICA_COUNT=1
