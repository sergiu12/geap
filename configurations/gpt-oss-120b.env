# ==============================================================================
# Model Preset: OpenAI GPT-OSS-120B (MXFP4 Quantized MoE)
# ==============================================================================

# Model Identification
MODEL_ID=openai/gpt-oss-120b
IMAGE_NAME=gpt-oss-120b
MODEL_NAME=gpt-oss-120b-geap
ENDPOINT_NAME=gpt-oss-120b-endpoint

# vLLM Engine Settings
TENSOR_PARALLEL_SIZE=1
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.92
MAX_NUM_SEQS=128
MAX_NUM_BATCHED_TOKENS=4096
REASONING_PARSER=openai_gptoss
TOOL_CALL_PARSER=openai
ENFORCE_EAGER=true
DTYPE=auto
SHARED_MEMORY_MB=16384

# Hardware & Accelerator Configurations
# Options:
#   - 1x NVIDIA H100 80GB (a3-highgpu-1g) [Recommended]
#   - 1x NVIDIA RTX PRO 6000 96GB (g4-standard-48) [Recommended - Blackwell 96GB]
#   - 1x NVIDIA A100 80GB (a2-ultragpu-1g)
#   - 8x NVIDIA L4 24GB (g2-standard-96, TENSOR_PARALLEL_SIZE=8)
MACHINE_TYPE=a3-highgpu-1g
ACCELERATOR_TYPE=nvidia-h100-80gb
ACCELERATOR_COUNT=1
MIN_REPLICA_COUNT=1
MAX_REPLICA_COUNT=1
