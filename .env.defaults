# ==============================================================================
# Baseline Non-Sensitive Configuration Defaults (Committed to Git)
# ==============================================================================

# Model Preset Selection (Loads preset from configurations/<CONFIG>.env)
# Options: gpt-oss-120b, gemma-4, generic, or custom filename in configurations/
CONFIG=gpt-oss-120b

# Google Cloud Infrastructure Settings
REGION=us-central1
ARTIFACT_REGISTRY_REPOSITORY_NAME=geap-models
IMAGE_NAME=gpt-oss-120b
TAG=latest
MODEL_NAME=gpt-oss-120b-geap
ENDPOINT_NAME=gpt-oss-120b-endpoint

# Model & Engine Configurations (Defaults for gpt-oss-120b, overridden by CONFIG preset or .env)
MODEL_ID=openai/gpt-oss-120b
TENSOR_PARALLEL_SIZE=1
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.92
MAX_NUM_SEQS=128
MAX_NUM_BATCHED_TOKENS=4096
REASONING_PARSER=openai_gptoss
TOOL_CALL_PARSER=openai
ENFORCE_EAGER=true
DTYPE=auto
SHARED_MEMORY_MB=16384

# Hardware & Accelerator Configurations (Default: 1x H100 80GB; also supports G4 / A2 / G2)
# E.g. G4: MACHINE_TYPE=g4-standard-48, ACCELERATOR_TYPE=nvidia-rtx-pro-6000
MACHINE_TYPE=a3-highgpu-1g
ACCELERATOR_TYPE=nvidia-h100-80gb
ACCELERATOR_COUNT=1
MIN_REPLICA_COUNT=1
MAX_REPLICA_COUNT=1

# Build & API settings
BUILD_METHOD=cloudbuild
SKIP_BUILD=false
ENABLE_APIS=true
